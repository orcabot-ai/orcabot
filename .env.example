# Optional; otherwise a fresh random service key is generated at startup.
# ORCABOT_TOKEN=
# ORCABOT_RUNTIME_ENDPOINT=/absolute/path/to/kernel.sock
# ORCABOT_DATA_DIR=./.orcabot
# ORCABOT_HOST=127.0.0.1
# ORCABOT_PORT=4310
# Optional canonical origin for a reverse proxy, or http://127.0.0.1:5173 for pnpm dev.
# ORCABOT_PUBLIC_URL=https://orcabot.example.com
